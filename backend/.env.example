# Copy to .env and fill in. The server refuses to start when a required value is missing or too
# short, so nothing here silently falls back to an insecure default.

# Environment: dev | test | production
ENV=dev

# Database — set DATABASE_URL (managed provider), or the MYSQL_* values (local Docker)
# DATABASE_URL=mysql://user:password@host:3306/database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=ceco_dev
MYSQL_TEST_DB=ceco_test
MYSQL_USER=ceco_user
MYSQL_PASSWORD=ceco_pass

# TLS to the database: off (local) | verify (check the certificate) | no-verify (encrypt only).
# Managed MySQL with a self-signed certificate needs no-verify, or paste its CA into DATABASE_SSL_CA.
DATABASE_SSL=off
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Passwords: PASSWORD_PEPPER is required and must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PASSWORD_PEPPER=
SALT_ROUNDS=10

# JWT: TOKEN_SECRET is required and must be at least 32 characters (generate it the same way).
# Access tokens cannot be revoked, so keep them short-lived; the refresh cookie carries the session.
TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# Where the browser may send the refresh cookie. Defaults to 'strict' locally and 'none' in
# production, where the frontend and the API sit on different sites. Set it to 'strict' only when
# both are served from one site; 'none' requires ENV=production, which is what sets Secure.
REFRESH_COOKIE_SAMESITE=

# Server
PORT=3000
# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGIN=http://localhost:4200
# Absolute URL this API is reached at. The local storage driver builds image URLs from it, so it
# must be the address the browser uses — not 127.0.0.1 if the site is served from elsewhere.
PUBLIC_BASE_URL=http://localhost:3000
# Number of proxies in front of the app (Railway and similar: 1). It decides which IP the rate
# limiter and the audit log record.
TRUST_PROXY=1
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Image and file storage
# ---------------------------------------------------------------------------
# auto  -> R2 when the four R2 values below are set, local disk otherwise
# r2    -> always Cloudflare R2 (start-up fails when a value is missing)
# local -> always the local disk, under UPLOAD_DIR and served at /uploads
STORAGE_DRIVER=auto

# Cloudflare R2. Create the bucket, then an "Account API token" with Object Read & Write.
# R2_ACCOUNT_ID is the 32-character id in your Cloudflare dashboard URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public hostname that serves the bucket: either the r2.dev subdomain you enable on the bucket,
# or your own domain connected to it. No trailing slash.
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=
# Optional: override the endpoint (defaults to https://<account-id>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# Folder prefix inside the bucket
R2_PREFIX=ceco

# Local-disk driver: where files are written, relative to the backend folder
UPLOAD_DIR=uploads
# Largest single upload, in megabytes
MAX_UPLOAD_MB=15

# Limits (optional)
API_RATE_LIMIT=500
AUTH_RATE_LIMIT=20
JSON_BODY_LIMIT=1mb

# Days an entry is kept before the daily cleanup deletes it (optional)
AUDIT_LOG_RETENTION_DAYS=90

# Admin bootstrap — used only by `npm run seed:admin`, which creates (or updates) the one admin
# account. The password must be at least 12 characters; leave it empty here and set it in .env only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=CECO
ADMIN_LAST_NAME=Admin
